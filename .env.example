# RentEase Kenya — environment configuration
# Copy to .env and fill in real values. NEVER commit .env.

# PostgreSQL connection string
DATABASE_URL="postgresql://rentalhub:rentalhub_dev_pw@127.0.0.1:5432/rentalhub?schema=public"

# Secret used to sign session cookies (generate: openssl rand -base64 32)
AUTH_SECRET="change-me-to-a-long-random-string"

# Public base URL of the app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Initial admin account created by prisma/seed.ts
ADMIN_EMAIL="admin@rentease.co.ke"
ADMIN_PASSWORD="Admin@12345"
ADMIN_NAME="Platform Admin"
ADMIN_PHONE="+254700000000"

# Optional S3-compatible storage (not required when using local disk storage)
STORAGE_DRIVER="local" # local | s3
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_PUBLIC_URL=

# Email (optional, for future transactional emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Set to "true" to seed demo landlords/tenants/buildings/payments (development only)
SEED_DEMO_DATA="true"
